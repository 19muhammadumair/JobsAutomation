# ============================================================
# Indeed Job Scraper — Environment Variables
# ============================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.

# --- WhatsApp via whatsapp-web.js (self-hosted, open-source) ---
# Start:  node whatsapp_service.js
# Scan the QR code in the terminal on first run.
WA_SERVICE_URL=http://localhost:3001

# Chat ID — individual or group:
#   Individual : 447751988524@c.us       (country code + number, no +)
#   Group      : 120363XXXXXXXXX@g.us    (run: python indeed_scraper.py --list-groups)
WHATSAPP_CHAT_ID=120363XXXXXXXXX@g.us

# --- Residential Proxies (comma-separated) ---
# Format: host:port:user:pass  or  host:port
# Leave empty to run without proxies.
PROXY_LIST=proxy1.example.com:8080:user1:pass1,proxy2.example.com:8080:user2:pass2

# --- Optional path overrides ---
# DB_PATH=/absolute/path/to/jobs.db
# LOG_PATH=/absolute/path/to/scraper.log
